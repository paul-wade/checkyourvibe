dist/
coverage/
*.log
.DS_Store
.env
.env.local
*.tsbuildinfo
.cyv-review/

# .NET build output. Scoped to the C# analyzer: a bare `bin/` also matched
# packages/analyzer-typescript/src/bin, which is TypeScript source, and dropped
# it when the public repository was created from a fresh `git add`.
packages/analyzer-csharp/src/bin/
packages/analyzer-csharp/src/obj/
*.tsbuildinfo

# Real provenance deny list — names the employer/people/products being scrubbed.
# Committing it would publish exactly what the check exists to prevent.
.cyv-provenance-deny
target/
# A pnpm store created inside the checkout. 5.5 GB, and vitest was matching
# test files inside it, so every suite ran twice.
.pnpm-store/
.cyv-dispatch/

# Agent worktrees and local session state, never shared.
.claude/

# Agent glue `cyv init` writes. Every hook command in it is an absolute path to
# this machine's node and this checkout, so committing it would hand another
# machine hooks that point at nothing. It is regenerated by `cyv init`, and
# `cyv doctor` reports its absence as drift.
.agents/
.devin/

# Marketing drafts and figures live outside this repository, at R:/cyv-marketing.
# This entry exists only so a stray recreation here cannot be committed.
marketing/
